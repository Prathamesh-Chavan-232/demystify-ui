{
  "name": "demystify-monorepo",
  "version": "1.0.0",
  "description": "Customizable UI library and design-system generator",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:golden": "turbo run test:golden",
    "test:visual": "docker compose --profile tools run --rm visual",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "db:up": "docker compose --profile tools run --rm migrate up",
    "db:down": "docker compose --profile tools run --rm migrate down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "private": true
}
