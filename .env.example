# ---------------------------------------------------------------------------
# HOST form. See PLAN.md "The two-URL footgun".
# This file carries the localhost form, used by the web app, the CLI, and
# host-side sqlc/goose. compose.yaml overrides DATABASE_URL per-service with
# the in-network form (postgres://...@postgres:5432/demystify).
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://demystify:demystify@localhost:5432/demystify

POSTGRES_USER=demystify
POSTGRES_PASSWORD=demystify
POSTGRES_DB=demystify

# Auth: hosted provider, Go API verifies JWTs. See PLAN.md "Auth".
AUTH_JWKS_URL=
AUTH_ISSUER=

# Go service ports
API_PORT=8080
PALETTE_PORT=8081
AUDIT_PORT=8082

# Host uid/gid for containers that write into the bind-mounted repo (visual).
# Without these, generated baselines land root-owned.
UID=1000
GID=1000
